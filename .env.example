# Hithub Environment Variables
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="file:./data/hithub.db"
# For PostgreSQL: DATABASE_URL="postgresql://hithub:hithub_pass@localhost:5432/hithub?schema=public"

# Auth Secret
BETTER_AUTH_SECRET="hithub-super-secret-key-change-in-production-32chars"
NEXTAUTH_URL="http://localhost:3000"

# Storage
STORAGE_DRIVER="local" # local or s3
STORAGE_PATH="./data/storage"

# AI Gateway
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# GitHub Importer / OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
