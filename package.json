{
  "name": "hithub-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:push": "pnpm --filter @hithub/database db:push",
    "db:seed": "pnpm --filter @hithub/database db:seed",
    "cli": "pnpm --filter @hithub/cli start"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=18.0.0"
  }
}
